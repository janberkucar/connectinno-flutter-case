# Neon (or any PostgreSQL) — async URL
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: allow all origins in dev (set 0 in production and list exact origins)
CORS_ALLOW_ALL=1
